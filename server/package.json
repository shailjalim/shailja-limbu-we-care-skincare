{
  "name": "we-care-server",
  "version": "1.0.0",
  "description": "Backend server for We Care application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "migrate:products": "node migrateProductRecommendationFields.js",
    "migrate:remove-product-prices": "node migrateRemoveProductPrices.js",
    "seed:quiz-config": "node seedQuizScoringConfig.js"
  },
  "keywords": [
    "mern",
    "express",
    "mongodb",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.1"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "mongodb-memory-server": "^8.13.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "jest": {
    "collectCoverageFrom": [
      "controllers/testController.js",
      "routes/testRoutes.js",
      "utils/**/*.js",
      "!utils/emailService.js",
      "!utils/sendEmail.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 65,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
