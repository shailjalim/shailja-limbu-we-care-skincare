{
  "name": "we-care-client",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.3",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --watchAll=false --coverage --runInBand",
    "eject": "react-scripts eject"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/components/PrivateRoute.jsx",
      "src/components/AdminRoute.jsx",
      "src/services/api.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 20,
        "functions": 10,
        "lines": 25,
        "statements": 25
      },
      "./src/components/PrivateRoute.jsx": {
        "branches": 90,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/components/AdminRoute.jsx": {
        "branches": 90,
        "functions": 100,
        "lines": 100,
        "statements": 100
      },
      "./src/services/api.js": {
        "branches": 13,
        "functions": 11,
        "lines": 25,
        "statements": 25
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://localhost:5000",
  "devDependencies": {
    "autoprefixer": "^10.4.24",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  }
}
